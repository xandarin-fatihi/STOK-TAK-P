## Optional settings for LOCAL/START.ps1. Copy to LOCAL/.local.env if needed.
## The runner chooses project-relative data paths automatically.
PORT=6075
ADMIN_USERNAME=admin
NODE_ENV=development
NOTIFICATION_WORKERS_ENABLED=false
ADMIN_COOKIE_NAME=stok_takip_admin_session
RECIPE_COOKIE_NAME=stok_takip_personel_session
JWT_ISSUER=stok-takip-sistemi-backend
JWT_AUDIENCE=stok-takip-sistemi-apps

## Leave paths blank to let START.ps1 select this checkout's own directories.
DATA_FILE=
MEDIA_DIR=
PROCUREMENT_DOCUMENTS_DIR=
DATA_IMPORT_COLD_DIR=
BACKUP_DIR=
LOG_DIR=
PWA_RELEASE_ID=
PWA_RELEASE_NOTES=[]

## On a fresh installation START.ps1 creates a random JWT secret and initial
## admin password in the ignored LOCAL/.local.env file. Never commit that file.
## Never copy a production secret or password into this example.
